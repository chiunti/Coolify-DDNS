# Copy to .env and fill in your values. Do NOT commit the real .env.

# Your domain managed by Namecheap DNS
DDNS_DOMAIN=example.com

# Dynamic DNS Password from Namecheap > Advanced DNS > Dynamic DNS
# (NOT your account password)
DDNS_PASSWORD=

# Host of the A + Dynamic DNS record: "@" for root domain, or a subdomain like "home"
DDNS_HOST=@

# Seconds between public IP checks
CHECK_INTERVAL=120
